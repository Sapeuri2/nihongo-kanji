 "lessons": [
  {
   "id": "k5-21",
   "title": "On ou kun ?",
   "sections": [
    {
     "h": "La règle de base",
     "p": [
      "**Kun** : la lecture japonaise. Kanji seul, ou suivi de kana (okurigana) : {食|た}べる, {山|やま}.",
      "**On** : la lecture venue du chinois. Kanji collés entre eux : {学生|がくせい}, {電車|でんしゃ}.",
      "En katakana dans les fiches : on. En hiragana : kun."
     ],
     "vocab": [
      {
       "jp": "Kanji + kana",
       "fr": "kun · {高|たか}い, {行|い}く"
      },
      {
       "jp": "Kanji seul",
       "fr": "kun · {水|みず}, {人|ひと}"
      },
      {
       "jp": "Deux kanji ou plus",
       "fr": "on · {毎日|まいにち}, {来週|らいしゅう}"
      }
     ]
    }
   ],
   "pieges": [
    "Il y a des exceptions : {今年|ことし}, {大人|おとな}, {今日|きょう} se lisent en bloc.",
    "Certains composés sont en kun : {名前|なまえ}, {手紙|てがみ}."
   ],
