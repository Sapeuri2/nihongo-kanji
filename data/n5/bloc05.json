  {
   "id": "k5-23",
   "title": "Les kanji qui se ressemblent",
   "sections": [
    {
     "h": "Paires à séparer",
     "p": [
      "Regarde le détail qui change, et rattache chaque kanji à un mot connu."
     ],
     "vocab": [
      {
       "jp": "日 / 目",
       "fr": "目 a deux barres et il est plus haut (un œil)."
      },
      {
       "jp": "大 / 犬 / 太",
       "fr": "犬 : point en haut à droite. 太 : point en bas."
      },
      {
       "jp": "土 / 士",
       "fr": "土 : barre du bas plus longue. 士 : barre du haut plus longue."
      },
      {
       "jp": "末 / 未",
       "fr": "末 : barre du haut longue (la fin). 未 : barre du haut courte (pas encore)."
      },
      {
       "jp": "人 / 入 / 八",
       "fr": "入 : le trait de droite domine. 八 : traits séparés."
      },
      {
       "jp": "午 / 牛",
       "fr": "牛 a une corne : le trait central dépasse."
      },
      {
       "jp": "聞 / 間",
       "fr": "聞 : une oreille 耳 dans la porte. 間 : un soleil 日."
      },
      {
       "jp": "右 / 左",
       "fr": "右 : bouche 口 (mange). 左 : outil 工."
      },
      {
       "jp": "毎 / 母",
       "fr": "毎 = 母 + un chapeau."
      },
      {
       "jp": "白 / 百",
       "fr": "百 = 白 + un trait au-dessus."
      }
     ]
    }
   ],
   "pieges": [
